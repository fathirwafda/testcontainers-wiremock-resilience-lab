{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/payment/v1/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.customerId == 'cust-slow')]"
      }
    ]
